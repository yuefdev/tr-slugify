{
  "name": "tr-slugify",
  "version": "0.1.0",
  "description": "Tiny zero-dependency slugify for Turkish text",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts"
  ],
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "slug",
    "slugify",
    "turkish",
    "url"
  ],
  "author": "Yusuf Efe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuefdev/tr-slugify.git"
  },
  "engines": {
    "node": ">=18"
  }
}
